{
  "name": "edit_studio",
  "version": "1.0.0",
  "private": true,
  "description": "Edito - Decoupled Monorepo with Client-Side Frontend and Express Backend",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "start": "npm --prefix frontend start",
    "lint": "npm --prefix frontend run lint",
    "server:dev": "npm --prefix backend run dev",
    "server:start": "npm --prefix backend start",
    "server:test": "node backend/test.js"
  }
}

