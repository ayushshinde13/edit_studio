# ==============================================================================
# Edito Standalone Express.js Backend Environment Configuration
# ==============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=development

# Allowed CORS Origin (Your Next.js Frontend URL)
FRONTEND_URL=http://localhost:3000

# Security & JWT Tokens (PRD Section 17.1)
JWT_SECRET=edito_super_secure_jwt_secret_key_2026_change_in_production
ADMIN_EMAIL=admin@edito.studio
ADMIN_PASSWORD=adminedito2026

# Privacy Salt for Visitor IP Hashing (PRD Section 17.9)
IP_SALT=edito_dynamic_salt_change_weekly

# ==============================================================================
# Database Configuration (MongoDB)
# ==============================================================================
# Local MongoDB:
MONGODB_URI=mongodb://127.0.0.1:27017/edito_studio

# Or MongoDB Atlas Cloud Cluster:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/edito_studio?retryWrites=true&w=majority
