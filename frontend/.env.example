# ==============================================================================
# Edito Frontend (Next.js) Environment Configuration
# ==============================================================================

# Public Web URL (used for canonical URLs, sitemaps, and OpenGraph social cards)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Backend API URL (points to your Express.js + MongoDB backend service)
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1

# Salt for server-side anonymization of telemetry & IP hashing (PRD Section 17.9)
ANALYTICS_SALT=edito_privacy_salt_change_in_production_2026
